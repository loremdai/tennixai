TENNIX_PROVIDER_MODE=fake
TENNIX_LIVETENNIS_API_KEY=
TENNIX_LIVETENNIS_BASE_URL=https://api.livetennisapi.com/api/public/v1
TENNIX_API_TENNIS_API_KEY=
TENNIX_API_TENNIS_BASE_URL=https://api.api-tennis.com/tennis/
TENNIX_API_TENNIS_WS_URL=wss://wss.api-tennis.com/live
TENNIX_LLM_MODE=fake
TENNIX_LLM_API_KEY=
TENNIX_LLM_BASE_URL=
TENNIX_LLM_MODEL=qwen3.8-max-0902
TENNIX_LLM_TIMEOUT_SECONDS=45
TENNIX_PRODUCT_TIMEZONE=Asia/Macau
TENNIX_BACKEND_URL=http://127.0.0.1:8000
TENNIX_DATABASE_URL=postgresql+asyncpg://tennix:tennix@127.0.0.1:5432/tennix
TENNIX_REDIS_URL=redis://127.0.0.1:6379/0
TENNIX_RAW_PAYLOAD_RETENTION_DAYS=14
TENNIX_MAX_LIVE_SUBSCRIPTIONS=8
TENNIX_VIEWER_LEASE_SECONDS=45
TENNIX_SUBSCRIPTION_GRACE_SECONDS=60
# P3 market intelligence and paper trading. Public read-only Polymarket
# endpoints only; never add wallet, private key or trading credentials here.
TENNIX_P3_MODE=disabled
TENNIX_P3_FIXED_STAKE_USD=10
TENNIX_POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
TENNIX_POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
TENNIX_POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
TENNIX_P3_MODEL_ARTIFACT_DIR=artifacts/p3
TENNIX_P3_MAX_MARKET_SUBSCRIPTIONS=8
TENNIX_P3_MARKET_BOOK_FRESHNESS_SECONDS=5
TENNIX_P3_DECISION_FRESHNESS_SECONDS=15
# Opt-in real-service test gates. Disabled by default; set to 1 only for
# bounded live runs. Never place credential values in this file.
TENNIX_RUN_API_TENNIS_LIVE=0
TENNIX_RUN_LLM_LIVE=0
TENNIX_RUN_PLAYER_ALIAS_LLM_LIVE=0
TENNIX_RUN_PLAYER_DIRECTORY_E2E_LIVE=0
